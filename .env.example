# ── Build-time configuration (all optional — see src/lib/env.ts) ───────────────
# Copy to .env.local for local overrides. CI injects these per environment.

# Which environment this bundle is: local | dev | staging | production
VITE_APP_ENV=local

# Base path the site is served from (GitHub Pages sub-paths, docker = /)
# production → /llm-infra-planner/   staging → /llm-infra-planner/staging/   dev → /llm-infra-planner/dev/
VITE_BASE_PATH=/

# Optional: absolute URL of a WASI runtime host. Leave empty to use same-origin /api
# (dev: proxied by vite to http://127.0.0.1:8787 · docker: proxied by nginx)
VITE_WASI_BASE_URL=

# Proxy target used by `vite dev` / `vite preview` for /api/*
WASI_PROXY_TARGET=http://127.0.0.1:8787

# Injected by CI, shown on the Runtime page
VITE_APP_VERSION=0.0.0
VITE_COMMIT=local
VITE_BUILT_AT=
