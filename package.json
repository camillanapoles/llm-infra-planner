{
  "name": "llm-hardware-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate-data.ts",
    "stack": "node scripts/dev-stack.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:kernel": "node scripts/build-wasm.mjs --kernel-only",
    "build:app": "tsc -b && vite build",
    "wasi": "node scripts/wasi-run.mjs",
    "wasi:serve": "node scripts/wasi-server.mjs",
    "wasm:verify": "node scripts/verify-wasm.mjs",
    "deploy:docker": "node scripts/docker-build.mjs",
    "clean": "rm -rf dist wasi/dist public/wasm",
    "serve": "node scripts/serve-static.mjs",
    "serve:pages": "node scripts/serve-static.mjs _site",
    "build:pages": "node scripts/build-pages-artifact.mjs",
    "continuity": "tsx scripts/continuity.ts",
    "continuity:status": "tsx scripts/continuity.ts status",
    "continuity:sync": "tsx scripts/continuity.ts sync",
    "continuity:check": "tsx scripts/continuity.ts check",
    "continuity:start": "tsx scripts/continuity.ts start",
    "continuity:resume": "tsx scripts/continuity.ts resume",
    "validate:workflows": "python3 scripts/validate-workflows.py"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "nuqs": "^2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "assemblyscript": "^0.28.20",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.1.1",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.4",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.3"
  }
}
